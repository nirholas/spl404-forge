# Browser RPC endpoints. Everything here ships to the browser, so never put a
# secret-bearing URL in a VITE_* variable. Both are optional: the app falls back
# to public endpoints, and a viewer can set their own in Settings.
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
